{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexzh3.github.io/codex-orchestrator/schemas/codex-orchestrator.schema.json",
  "title": "Codex Orchestrator Runtime Schemas",
  "description": "Schema bundle for state.json and ledger.jsonl records.",
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "run_id",
        "repo",
        "created_at",
        "status",
        "sessions"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "blocked",
            "complete",
            "needs_review",
            "accepted",
            "rejected"
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "name",
        "thread_id",
        "mode",
        "rollout_path",
        "branch",
        "worktree",
        "status",
        "last_seen_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "ide",
            "exec"
          ]
        },
        "rollout_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "idle",
            "complete",
            "failed",
            "awaiting-approval",
            "unknown"
          ]
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_source": {
          "type": "string",
          "enum": [
            "ide",
            "exec"
          ]
        },
        "parse_confidence": {
          "type": "string",
          "enum": [
            "low",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "ledger_event": {
      "oneOf": [
        {
          "$ref": "#/$defs/verification_event"
        },
        {
          "$ref": "#/$defs/consensus_event"
        },
        {
          "$ref": "#/$defs/task_event"
        },
        {
          "$ref": "#/$defs/task_created_event"
        },
        {
          "$ref": "#/$defs/task_updated_event"
        },
        {
          "$ref": "#/$defs/file_claimed_event"
        },
        {
          "$ref": "#/$defs/dispatch_started_event"
        },
        {
          "$ref": "#/$defs/dispatch_completed_event"
        },
        {
          "$ref": "#/$defs/task_checkpoint_event"
        },
        {
          "$ref": "#/$defs/review_event"
        },
        {
          "$ref": "#/$defs/gate_result_event"
        },
        {
          "$ref": "#/$defs/run_closed_event"
        },
        {
          "$ref": "#/$defs/run_meta_event"
        },
        {
          "$ref": "#/$defs/generic_event"
        }
      ]
    },
    "verification_event": {
      "type": "object",
      "required": [
        "type",
        "kind",
        "result",
        "recorded_at",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "verification"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "git_diff",
            "test",
            "typecheck",
            "lint",
            "build",
            "benchmark",
            "screenshot",
            "artifact_check",
            "manual_review",
            "custom"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "inconclusive",
            "needs_human_review"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string"
        },
        "covers_tasks": {
          "$ref": "#/$defs/string_list"
        },
        "scope": {
          "type": "string",
          "enum": [
            "task",
            "global"
          ]
        },
        "command": {
          "type": "string"
        },
        "command_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "acceptance_test": {
          "type": "boolean"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "stochastic": {
          "type": "boolean"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "consensus_event": {
      "type": "object",
      "required": [
        "type",
        "recorded_at",
        "finding",
        "outcome",
        "resolution",
        "evidence"
      ],
      "properties": {
        "type": {
          "const": "consensus"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "root_cause": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "consensus",
            "claude_decision",
            "user_action_required"
          ]
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "resolution_basis": {
          "type": "string",
          "enum": [
            "rerun_passed",
            "repro_not_reproduced",
            "accepted_risk",
            "non_executable_convention",
            "user_override"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/string_list"
        },
        "clears": {
          "$ref": "#/$defs/string_list"
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_list"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "requires_user": {
          "type": "boolean"
        },
        "status": {
          "description": "Deprecated legacy field. Prefer outcome.",
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "deferred",
            "resolved"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "task_event": {
      "type": "object",
      "required": [
        "type",
        "id",
        "title",
        "status"
      ],
      "properties": {
        "type": {
          "const": "task"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "active",
            "pending",
            "blocked",
            "failed"
          ]
        },
        "owner": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "task_created_event": {
      "type": "object",
      "required": [
        "type",
        "id",
        "title",
        "status"
      ],
      "properties": {
        "type": {
          "const": "task_created"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "active",
            "pending",
            "blocked",
            "failed"
          ]
        },
        "owner": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "depends_on": {
          "$ref": "#/$defs/string_list"
        },
        "context": {
          "$ref": "#/$defs/string_list"
        },
        "constraints": {
          "$ref": "#/$defs/string_list"
        },
        "files_allowed": {
          "$ref": "#/$defs/string_list"
        },
        "files_forbidden": {
          "$ref": "#/$defs/string_list"
        },
        "acceptance": {
          "$ref": "#/$defs/string_list"
        },
        "verification_required": {
          "$ref": "#/$defs/string_list"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "task_updated_event": {
      "type": "object",
      "required": [
        "type",
        "id",
        "status"
      ],
      "properties": {
        "type": {
          "const": "task_updated"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "active",
            "pending",
            "blocked",
            "failed"
          ]
        },
        "notes": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "file_claimed_event": {
      "type": "object",
      "required": [
        "type",
        "task_id",
        "agent",
        "allow"
      ],
      "properties": {
        "type": {
          "const": "file_claimed"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "allow": {
          "$ref": "#/$defs/non_empty_string_list"
        },
        "forbid": {
          "$ref": "#/$defs/string_list"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "dispatch_started_event": {
      "type": "object",
      "required": [
        "type",
        "task_id",
        "agent",
        "mode",
        "prompt_path",
        "log_path"
      ],
      "properties": {
        "type": {
          "const": "dispatch_started"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "ide",
            "exec"
          ]
        },
        "prompt_path": {
          "type": "string",
          "minLength": 1
        },
        "log_path": {
          "type": "string",
          "minLength": 1
        },
        "fresh_session": {
          "type": "boolean"
        },
        "reuse_reason": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "dispatch_completed_event": {
      "type": "object",
      "required": [
        "type",
        "task_id",
        "agent",
        "status"
      ],
      "properties": {
        "type": {
          "const": "dispatch_completed"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "Dispatch completion status follows session lifecycle statuses.",
          "type": "string",
          "enum": [
            "active",
            "idle",
            "complete",
            "failed",
            "awaiting-approval",
            "unknown"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "task_checkpoint_event": {
      "type": "object",
      "required": [
        "type",
        "task_id",
        "agent",
        "status",
        "summary",
        "files_changed"
      ],
      "properties": {
        "type": {
          "const": "task_checkpoint"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "active",
            "pending",
            "blocked",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "files_changed": {
          "$ref": "#/$defs/string_list"
        },
        "tests_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "unresolved_blockers": {
          "$ref": "#/$defs/string_list"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "review_event": {
      "type": "object",
      "required": [
        "type",
        "task_id",
        "reviewer",
        "kind",
        "result"
      ],
      "properties": {
        "type": {
          "const": "review"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "diff",
            "test",
            "manual",
            "custom"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "inconclusive",
            "needs_human_review"
          ]
        },
        "command": {
          "type": "string"
        },
        "prompt_path": {
          "type": "string"
        },
        "log_path": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "$ref": "#/$defs/string_list"
        },
        "blocking_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocking_finding"
          }
        },
        "final": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "gate_result_event": {
      "type": "object",
      "required": [
        "type",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "gate_result"
        },
        "ok": {
          "type": "boolean"
        },
        "passed": {
          "description": "Deprecated compatibility alias. Prefer ok.",
          "type": "boolean"
        },
        "blocking": {
          "$ref": "#/$defs/string_list"
        },
        "warnings": {
          "$ref": "#/$defs/string_list"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "run_closed_event": {
      "type": "object",
      "required": [
        "type",
        "status"
      ],
      "properties": {
        "type": {
          "const": "run_closed"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "blocked",
            "complete",
            "needs_review",
            "accepted",
            "rejected"
          ]
        },
        "summary": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "run_meta_event": {
      "type": "object",
      "required": [
        "type",
        "recorded_at",
        "run_id",
        "protocol_version",
        "schema_version"
      ],
      "properties": {
        "type": {
          "const": "run_meta"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "plugin_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugin_git_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "claude_code_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "codex_cli_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_suite": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/run_meta_config"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "run_meta_config": {
      "type": "object",
      "properties": {
        "session_reuse_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_final_codex_review": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "require_file_claims": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "generic_event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "not": {
            "enum": [
              "verification",
              "consensus",
              "task",
              "task_created",
              "task_updated",
              "file_claimed",
              "dispatch_started",
              "dispatch_completed",
              "task_checkpoint",
              "review",
              "gate_result",
              "run_closed",
              "run_meta"
            ]
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "blocking_finding": {
      "type": "object",
      "required": [
        "id",
        "claim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "file_refs": {
          "$ref": "#/$defs/string_list"
        },
        "repro_command": {
          "type": "string",
          "minLength": 1
        },
        "min_repro_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
