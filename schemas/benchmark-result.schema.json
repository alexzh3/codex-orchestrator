{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexzh3.github.io/codex-orchestrator/schemas/benchmark-result.schema.json",
  "title": "Codex Orchestrator Benchmark Result",
  "type": "object",
  "required": [
    "suite",
    "case_id",
    "plugin_ref",
    "repo_commit",
    "passed",
    "wall_seconds",
    "claude_turns",
    "codex_sessions",
    "codex_reviews",
    "manual_interventions",
    "prompt_log_pairs_complete",
    "ledger_errors",
    "gate_passed",
    "report_score",
    "external_score"
  ],
  "properties": {
    "suite": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "wall_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "claude_turns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "codex_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "codex_reviews": {
      "type": "integer",
      "minimum": 0
    },
    "manual_interventions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "prompt_log_pairs_complete": {
      "type": "boolean"
    },
    "ledger_errors": {
      "type": "integer",
      "minimum": 0
    },
    "gate_passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "report_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "external_score": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
