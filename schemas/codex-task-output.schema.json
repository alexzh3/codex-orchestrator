{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Task Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "files_changed",
    "tests_run",
    "unresolved_blockers"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
