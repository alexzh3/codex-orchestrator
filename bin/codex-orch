#!/usr/bin/env sh
set -eu

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  ROOT=$CLAUDE_PLUGIN_ROOT
else
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  ROOT=$(dirname -- "$SCRIPT_DIR")
fi

if [ "$#" -eq 0 ]; then
  exec python3 "$ROOT/scripts/codex_orch.py" --help
fi

exec python3 "$ROOT/scripts/codex_orch.py" "$@"
